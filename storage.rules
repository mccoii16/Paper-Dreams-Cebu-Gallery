rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 120 * 1024 * 1024 &&
                      request.resource.contentType.matches('(image|video)/.*');
      allow delete: if request.auth != null;
    }
  }
}
